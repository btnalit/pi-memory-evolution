{
	"name": "pi-memory-evolution",
	"version": "0.2.0",
	"description": "Automatic, scoped memory evolution using Pi's active model, transactional local storage, and bounded recall.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/btnalit/pi-memory-evolution.git"
	},
	"homepage": "https://github.com/btnalit/pi-memory-evolution",
	"bugs": {
		"url": "https://github.com/btnalit/pi-memory-evolution/issues"
	},
	"engines": {
		"node": ">=22.19"
	},
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-agent",
		"memory",
		"self-evolution"
	],
	"files": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"scripts": {
		"test": "node --test \"src/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"test:pi": "node scripts/test-pi.mjs",
		"check": "npm run typecheck && npm test && npm run check:package",
		"check:package": "npm pack --dry-run --json"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@types/node": "22.18.0",
		"typescript": "5.9.3"
	}
}

{
	"name": "pi-memory-evolution",
	"version": "0.4.0",
	"description": "Memory that maintains itself. Pi learns what matters, injects what this session needs, and recalls the rest — nothing to configure, no commands to learn.",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/btnalit/pi-memory-evolution.git"
	},
	"homepage": "https://github.com/btnalit/pi-memory-evolution",
	"bugs": {
		"url": "https://github.com/btnalit/pi-memory-evolution/issues"
	},
	"engines": {
		"node": ">=22.19"
	},
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-agent",
		"memory",
		"self-evolution"
	],
	"files": [
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"docs",
		"README.md",
		"README.cn.md",
		"assets/overview.png",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://raw.githubusercontent.com/btnalit/pi-memory-evolution/main/assets/overview.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"scripts": {
		"test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
		"typecheck": "tsc --noEmit",
		"test:pi": "node scripts/test-pi.mjs",
		"test:install": "node scripts/test-install.mjs",
		"check": "npm run typecheck && npm test && npm run check:package && npm run check:docs && npm run check:automation",
		"check:automation": "node scripts/check-automation.mjs",
		"build": "node scripts/build-package.mjs",
		"check:docs": "node scripts/check-doc-constants.mjs",
		"check:package": "node scripts/check-package.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "22.20.1",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"yaml": "2.9.0"
	}
}
